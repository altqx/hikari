#include "preludes.h"

std::string_view hikari::plugin_helper::documentPrelude()
{
    return R"hikari-lua(@HIKARI_DOCUMENT_LUA@)hikari-lua";
}

std::string_view hikari::plugin_helper::uiPrelude()
{
    return R"hikari-lua(@HIKARI_UI_LUA@)hikari-lua";
}

std::string_view hikari::plugin_helper::filesPrelude()
{
    return R"hikari-lua(@HIKARI_FILES_LUA@)hikari-lua";
}

std::string_view hikari::plugin_helper::jobPrelude()
{
    return R"hikari-lua(@HIKARI_JOB_LUA@)hikari-lua";
}
