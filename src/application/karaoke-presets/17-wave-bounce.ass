Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,code once,ln = _G.require "ln.kara"; ln.init(tenv)
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,code once,bounce = ln.wave.new("sine",400,12); lift = {{"fscy", function(v) return math.floor(100+v) end}}
