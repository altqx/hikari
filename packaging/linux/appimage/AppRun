#!/bin/sh
# usr/lib/hikarisub's qt.conf points Qt at the bundled plugins and QML modules; usr/lib/hikarisub-runtime/lib holds
# the libraries a host may lack, ahead of the host's.
HERE=$(dirname "$(readlink -f "$0")")
APPDIR=${APPDIR:-$HERE}
export APPDIR
LD_LIBRARY_PATH="$APPDIR/usr/lib/hikarisub-runtime/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LD_LIBRARY_PATH
exec "$APPDIR/usr/lib/hikarisub/hikarisub" "$@"
