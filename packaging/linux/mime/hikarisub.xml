<?xml version="1.0" encoding="UTF-8"?>
<!--
  shared-mime-info already defines the subtitle types, so for those this only attaches icons; the session type is
  HikariSub's own. audio/aac also claims *.ass, at weight 10 against text/x-ssa's 50, so the glob is belt and braces.
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="text/x-ssa">
    <glob pattern="*.ass" weight="60"/>
    <icon name="text-x-ssa"/>
  </mime-type>
  <mime-type type="application/x-subrip">
    <icon name="application-x-subrip"/>
  </mime-type>
  <mime-type type="text/x-microdvd">
    <icon name="text-x-microdvd"/>
  </mime-type>
  <mime-type type="application/x-hikarisub-session">
    <comment>HikariSub session</comment>
    <sub-class-of type="application/json"/>
    <glob pattern="*.hksession"/>
    <icon name="hikarisub"/>
  </mime-type>
</mime-info>
