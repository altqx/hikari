# nFPM configuration of the hikarisub deb and rpm (legacy wx app).
# cmake/PackageLinuxNative.cmake fills in the placeholders at package time:
# the version (1.3 of the installers spec: the "-" before a prerelease
# becomes "~"), the staged app tree, the generated file list and the
# dependencies (packaging/linux/resolve-deps.sh over deps-{deb,rpm}.map).
# Arch is not built here: it gets the AUR package (packaging/linux/aur).
name: hikarisub
arch: amd64
platform: linux
version: "@PKG_VERSION@"
version_schema: none
release: "1"
section: video
priority: optional
maintainer: altqx
vendor: altqx
homepage: https://github.com/altqx/hikari
license: GPL-3.0-or-later
description: |-
  Subtitle editor for ASS/SSA, SRT and MicroDVD
  HikariSub is a subtitle editor and player for ASS, SSA, SRT and other
  subtitle formats, with audio and video preview, typesetting tools, spell
  checking and Lua automation.

contents:
  # The app tree. It finds its resources beside the executable, so it stays
  # one relocatable tree, the same as in the tar.gz and the AppImage.
  - src: "@APP_TREE@"
    dst: /opt/hikarisub
    type: tree
    file_info:
      owner: root
      group: root
  - src: /opt/hikarisub/hikarisub
    dst: /usr/bin/hikarisub
    type: symlink
  - src: "@KIND_DEB@"
    dst: /opt/hikarisub/package-kind.txt
    packager: deb
    file_info:
      mode: 0644
  - src: "@KIND_RPM@"
    dst: /opt/hikarisub/package-kind.txt
    packager: rpm
    file_info:
      mode: 0644
  - src: "@COPYRIGHT@"
    dst: /usr/share/doc/hikarisub/copyright
    packager: deb
    file_info:
      mode: 0644
  - src: "@LICENSE@"
    dst: /usr/share/licenses/hikarisub/LICENSE
    packager: rpm
    type: license
    file_info:
      mode: 0644
@CONTENTS@
overrides:
  deb:
    depends:
@DEB_DEPENDS@
    recommends:
@DEB_RECOMMENDS@
  rpm:
    depends:
@RPM_DEPENDS@
    recommends:
@RPM_RECOMMENDS@

rpm:
  summary: Subtitle editor for ASS/SSA, SRT and MicroDVD
  group: Applications/Multimedia
  compression: zstd

deb:
  # xz rather than zstd: every dpkg in the test matrix reads it.
  compression: xz
