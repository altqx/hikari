<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- HikariSub's update through pkexec, for the deb and rpm packages.
     Same bytes on the main and legacy branches. -->
<policyconfig>
  <vendor>altqx</vendor>
  <vendor_url>https://github.com/altqx/hikari</vendor_url>
  <action id="io.github.altqx.HikariSub.update">
    <description>Update HikariSub</description>
    <message>Authentication is required to update HikariSub</message>
    <icon_name>hikarisub</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/opt/hikarisub/libexec/hikarisub-update-helper</annotate>
  </action>
</policyconfig>
