{
  "name": "hikarisub",
  "version-string": "0.1.0",
  "builtin-baseline": "ee6a47dac031930715bea2e6dfb9ad60caaa5d83",
  "dependencies": [
    "hikari-ffms2",
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat",
        "swresample",
        "swscale"
      ]
    },
    "libass",
    "gtest",
    "spix",
    "portaudio",
    "kddockwidgets",
    "luajit",
    {
      "name": "boost-regex",
      "features": [
        "icu"
      ]
    },
    {
      "name": "boost-locale",
      "features": [
        "icu"
      ]
    },
    "icu",
    "curl",
    "pcre2",
    "hunspell",
    "uchardet",
    {
      "name": "pkgconf",
      "host": true,
      "platform": "windows"
    }
  ],
  "overrides": [
    {
      "name": "ffmpeg",
      "version": "7.1.2",
      "port-version": 5
    }
  ],
  "features": {
    "vsfilter": {
      "description": "W2: the optional xy-VSFilter CSRI renderer (Windows; HIKARI_WITH_VSFILTER)",
      "dependencies": [
        {
          "name": "hikari-xy-vsfilter",
          "platform": "windows & x64"
        }
      ]
    }
  }
}
