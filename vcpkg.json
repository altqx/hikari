{
  "name": "hikarisub",
  "version-string": "0.1.0",
  "builtin-baseline": "ee6a47dac031930715bea2e6dfb9ad60caaa5d83",
  "dependencies": [
    "hikari-ffms2",
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat",
        "swresample",
        "swscale"
      ]
    },
    "libass",
    "gtest",
    "spix",
    "portaudio",
    "luajit",
    {
      "name": "boost-regex",
      "features": [
        "icu"
      ]
    },
    {
      "name": "boost-locale",
      "features": [
        "icu"
      ]
    },
    "icu",
    {
      "name": "pkgconf",
      "host": true,
      "platform": "windows"
    }
  ],
  "overrides": [
    {
      "name": "ffmpeg",
      "version": "7.1.2",
      "port-version": 5
    }
  ]
}
