-- Shared head of the S4 capture's Document scripts (drive.py's
-- document-scripts route puts it before each script's body, so every
-- script stays one self-contained file as legacy loads it). record(event,
-- subs) appends one JSON line to $HIKARI_CAPTURE_OUT: the script's tag, the
-- event, and when subs is given the Document as the script sees it (the
-- first Line's text, the Line count and the Script Info keys). A desktop
-- launch (the Windows route) cannot set the environment, so the path is
-- then read from capture-probe.cfg beside the script.
local tag = TAG

local function output()
    local v = os.getenv("HIKARI_CAPTURE_OUT")
    if v ~= nil then return v end
    local source = debug.getinfo(1, "S").source:gsub("^@", "")
    local dir = source:match("^(.*)[/\\][^/\\]*$")
    local f = dir and io.open(dir .. "/capture-probe.cfg", "r")
    if not f then return nil end
    local found
    for line in f:lines() do
        local k, val = line:gsub("\r$", ""):match("^%s*([%w_]+)%s*=(.*)$")
        if k == "HIKARI_CAPTURE_OUT" then found = val end
    end
    f:close()
    return found
end

local function str(s)
    return '"' .. tostring(s):gsub('[%c"\\]', function(c)
        local map = { ['"'] = '\\"', ['\\'] = '\\\\', ['\n'] = '\\n', ['\r'] = '\\r', ['\t'] = '\\t' }
        return map[c] or string.format("\\u%04x", c:byte())
    end) .. '"'
end

local function record(event, subs, extra)
    local fields = { '"script":' .. str(tag), '"event":' .. str(event) }
    if subs then
        local first, lines, keys = nil, 0, {}
        for i = 1, #subs do
            local l = subs[i]
            if l.class == "dialogue" then
                lines = lines + 1
                first = first or l.text
            elseif l.class == "info" then
                keys[#keys + 1] = str(l.key)
            end
        end
        fields[#fields + 1] = '"first":' .. str(first or "")
        fields[#fields + 1] = '"lines":' .. lines
        fields[#fields + 1] = '"info":[' .. table.concat(keys, ",") .. "]"
    end
    if extra then fields[#fields + 1] = extra end
    local f = assert(io.open(output(), "a"))
    f:write("{" .. table.concat(fields, ",") .. "}\n")
    f:close()
end

-- The script's top level ran: a load (or a reload).
record("load")

local function prefix(subs, sel)
    for i = 1, #subs do
        local l = subs[i]
        if l.class == "dialogue" then
            l.text = tag .. ":" .. l.text
            subs[i] = l
            return
        end
    end
end
