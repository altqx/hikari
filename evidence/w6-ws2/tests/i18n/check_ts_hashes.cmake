# Compares each TS catalog with the SHA-256 recorded when the build was
# configured (i18n/CMakeLists.txt).
file(STRINGS "${HASHES}" lines)
if(NOT lines)
    message(FATAL_ERROR "no catalog hashes in ${HASHES}")
endif()
set(changed "")
foreach(line IN LISTS lines)
    string(REGEX MATCH "^([0-9a-f]+)  (.+)$" _ "${line}")
    file(SHA256 "${CMAKE_MATCH_2}" now)
    if(NOT now STREQUAL CMAKE_MATCH_1)
        list(APPEND changed "${CMAKE_MATCH_2}")
    endif()
endforeach()
if(changed)
    message(FATAL_ERROR "the build changed: ${changed}")
endif()
list(LENGTH lines count)
message(STATUS "${count} catalogs unchanged since configure")
