# Two headless outputs side by side; the right one at scale 2 (mixed DPI).
output HEADLESS-1 mode 1600x1000 position 0 0 scale 1
output HEADLESS-2 mode 1600x1000 position 1600 0 scale 2
default_border normal
focus_follows_mouse no
# No border rule for HikariSub: its floating panels ask for client-side
# decorations (xdg-decoration), which sway gives a floating window. Step
# floating sets "border normal" on them for a while (floating-forced-frame).
seat seat0 fallback true
