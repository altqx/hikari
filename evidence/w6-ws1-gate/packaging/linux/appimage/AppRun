#!/bin/sh
# HikariSub AppImage entry point (installers spec 5.3), Qt rewrite.
#
# The app tree is usr/lib/hikarisub; its qt.conf points Qt at the bundled
# plugins and QML modules, so no QT_* variable is needed. The libraries of
# the full profile that the host may lack (xcb utilities, xkbcommon, ...)
# are in usr/lib/hikarisub-runtime/lib, ahead of the host's.
HERE=$(dirname "$(readlink -f "$0")")
APPDIR=${APPDIR:-$HERE}
export APPDIR
LD_LIBRARY_PATH="$APPDIR/usr/lib/hikarisub-runtime/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LD_LIBRARY_PATH
exec "$APPDIR/usr/lib/hikarisub/hikarisub" "$@"
