      },
      {
        "case": "defaults-escape",
        "macro": 1,
        "keys": [
          "Escape"
        ]
      },
      {
        "case": "buttons-return",
        "macro": 2,
        "keys": [
          "Return"
        ]
      },
      {
        "case": "buttons-escape",
        "macro": 3,
        "keys": [
          "Escape"
        ]
      },
      {
        "case": "button-id-unknown",
        "macro": 4,
        "keys": [
          "Return"
        ]
      },
      {
        "case": "button-id-invalid",
        "macro": 5
      },
      {
        "case": "float-step-up",
        "macro": 6,
        "keys": [
          "Up",
          "Return"
        ]
      },
      {
        "case": "int-step-up",
        "macro": 7,
        "keys": [
          "Up",
          "Return"
        ]
      },
      {
        "case": "edit-typed",
        "macro": 8,
        "keys": [
          "type:héllo",
          "Return"
        ]
      },
      {
        "case": "corpus",
        "macro": 9,
        "timeout": 120
      }
    ]
  },
