# O4: lupdate and the migration tool write the catalogs and the migration
# record with LF and the tests compare them byte for byte, so a Windows
# checkout must not convert them.
/i18n/** text eol=lf

# 38c: the attachment fixtures are compared byte for byte (CRLF script, font, image).
/tests/fixtures/attachments/** -text

# KE1: the karaoke template corpus and its goldens are compared byte for byte;
# the 3.2.2 reference script keeps its original bytes.
/tests/backends/karaoke-corpus/** -text

# KE3: the preset fixture and its goldens are compared byte for byte.
/tests/backends/karaoke-presets/** -text

# DK1: the fixed Tamil affix file is pinned by SHA-256 (CRLF, as upstream's).
/packaging/dictionaries/** -text

# CF2: the legacy list files are converted byte for byte (BOM, CRLF).
/tests/fixtures/list-files/** -text

/tests/ui/layout-fixtures/** -text
/.githooks/pre-push text eol=lf

# SC1: the sidecar is built byte for byte the same everywhere, and NOTICES.txt is compared with what its
# licence files generate.
/src/ai-sidecar/** text eol=lf
# The export goldens are compared byte for byte (CRLF and LF).
/tests/fixtures/export/** -text
/tests/fixtures/import/** -text
# FA3: the Aegisub extradata fixtures are compared byte for byte (BOM, CRLF).
/tests/fixtures/aegisub-extradata/** -text

# tools/icons/draw_icons.py writes the icons and their manifest with LF; tools.draw-icons compares them byte for byte.
/src/ui/icons/** text eol=lf

# PL1: signed fixtures; a converted line ending breaks the signature.
/tests/minisign/fixtures/** -text
/tests/plugins/fixtures/** -text

# tools.app-icons pins the icon masters, tools/icons/app_icons.py and its stamp by SHA-256.
/packaging/icons/** text eol=lf
/packaging/linux/icons/hicolor/scalable/** text eol=lf
/tools/icons/app_icons.* text eol=lf
