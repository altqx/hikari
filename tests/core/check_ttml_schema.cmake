if(NOT XMLLINT)
    message(FATAL_ERROR "xmllint was not found; install libxml2-utils")
endif()
file(GLOB documents "${GOLDENS}/*.ttml" "${GOLDENS}/*.dfxp")
if(NOT documents)
    message(FATAL_ERROR "No TTML or DFXP goldens in ${GOLDENS}")
endif()
execute_process(COMMAND "${XMLLINT}" --noout --nonet --schema "${SCHEMA}" ${documents}
    RESULT_VARIABLE result ERROR_VARIABLE output)
string(REGEX REPLACE "[^\n]*Schemas parser warning[^\n]*\n" "" output "${output}")
message("${output}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "The TTML goldens do not validate against the IMSC1 schema")
endif()
