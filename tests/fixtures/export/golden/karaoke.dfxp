<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:frameRate="24" ttp:frameRateMultiplier="1000 1001">
  <head>
    <styling>
      <style xml:id="Romaji" tts:fontFamily="&quot;Noto Sans&quot;,proportionalSansSerif" tts:fontSize="100%" tts:color="#C0E0FFFF" tts:fontWeight="bold" tts:textOutline="#002040FF 0.04em"/>
      <style xml:id="English" tts:fontFamily="&quot;Noto Sans&quot;,proportionalSansSerif" tts:fontSize="87.5%" tts:color="#FFFFFFFF" tts:textOutline="#202020FF 0.05em"/>
      <style xml:id="Kanji_Side" tts:fontFamily="&quot;Noto Sans JP&quot;,proportionalSansSerif" tts:fontSize="91.67%" tts:color="#FFFFFFFF"/>
      <style xml:id="Kanji_Side_box" tts:backgroundColor="#000000FF"/>
    </styling>
    <layout>
      <region xml:id="top" tts:origin="2.34% 3.47%" tts:extent="95.31% 31.01%" tts:displayAlign="before"/>
      <region xml:id="middle" tts:origin="2.34% 34.49%" tts:extent="95.31% 31.01%" tts:displayAlign="center"/>
      <region xml:id="bottom" tts:origin="2.34% 65.5%" tts:extent="95.31% 31.01%" tts:displayAlign="after"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="240f" end="312f" region="top" style="Romaji" tts:textAlign="center">kimi no koe</p>
      <p begin="240f" end="312f" region="bottom" style="English" tts:textAlign="center">Your voice</p>
      <p begin="288f" end="360f" region="middle" style="Kanji_Side" tts:textAlign="left"><span style="Kanji_Side_box">君の声</span></p>
      <p begin="312f" end="384f" region="top" style="Romaji" tts:textAlign="center">tooku made hibiku</p>
      <p begin="312f" end="384f" region="bottom" style="English" tts:textAlign="center">Echoes far away</p>
    </div>
  </body>
</tt>
