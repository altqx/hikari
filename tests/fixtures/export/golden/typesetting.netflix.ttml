<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:profile="http://www.w3.org/ns/ttml/profile/imsc1/text" ttp:frameRate="24" ttp:frameRateMultiplier="1000 1001">
  <head>
    <layout>
      <region xml:id="top" tts:origin="10% 10%" tts:extent="80% 40%" tts:displayAlign="before"/>
      <region xml:id="bottom" tts:origin="10% 50%" tts:extent="80% 40%" tts:displayAlign="after"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="480f" end="575f" region="top" tts:textAlign="center">SHIBUYA STATION</p>
      <p begin="480f" end="575f" region="top" tts:textAlign="center">Exit A3<br/>West gate</p>
      <p begin="503f" end="551f" region="bottom" tts:textAlign="center">Moving sign</p>
      <p begin="527f" end="599f" region="bottom" tts:textAlign="center">Clipped half</p>
      <p begin="551f" end="623f" region="top" tts:textAlign="center">Top right note</p>
      <p begin="575f" end="671f" region="bottom" tts:textAlign="center">Ticker news</p>
      <p begin="623f" end="671f" region="bottom" tts:textAlign="center">Centre <span tts:fontStyle="italic">reset</span> styled</p>
      <p begin="695f" end="719f" region="bottom" tts:textAlign="center">Unclosed {brace<br/>stays</p>
    </div>
  </body>
</tt>
