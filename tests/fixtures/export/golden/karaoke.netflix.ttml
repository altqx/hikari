<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:profile="http://www.w3.org/ns/ttml/profile/imsc1/text" ttp:frameRate="24" ttp:frameRateMultiplier="1000 1001">
  <head>
    <layout>
      <region xml:id="top" tts:origin="10% 10%" tts:extent="80% 40%" tts:displayAlign="before"/>
      <region xml:id="bottom" tts:origin="10% 50%" tts:extent="80% 40%" tts:displayAlign="after"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="240f" end="312f" region="top" tts:textAlign="center">kimi no koe</p>
      <p begin="240f" end="312f" region="bottom" tts:textAlign="center">Your voice</p>
      <p begin="288f" end="360f" region="bottom" tts:textAlign="center">君の声</p>
      <p begin="312f" end="384f" region="top" tts:textAlign="center">tooku made hibiku</p>
      <p begin="312f" end="384f" region="bottom" tts:textAlign="center">Echoes far away</p>
    </div>
  </body>
</tt>
