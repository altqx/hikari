<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:profile="http://www.w3.org/ns/ttml/profile/imsc1/text">
  <head>
    <styling>
      <style xml:id="Default" tts:fontFamily="Arial,proportionalSansSerif" tts:fontSize="100%" tts:color="#FFFFFFFF" tts:textOutline="#000000FF 0.04em"/>
      <style xml:id="Thoughts" tts:fontFamily="Arial,proportionalSansSerif" tts:fontSize="100%" tts:color="#FFFFFFFF" tts:fontStyle="italic" tts:textOutline="#000000FF 0.04em"/>
    </styling>
    <layout>
      <region xml:id="bottom" tts:origin="3.12% 65.12%" tts:extent="93.75% 30.24%" tts:displayAlign="after"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:00:01.000" end="00:00:03.500" region="bottom" style="Default" tts:textAlign="center">Good morning.</p>
      <p begin="00:00:04.000" end="00:00:06.200" region="bottom" style="Default" tts:textAlign="center">You're late <span tts:fontStyle="italic">again</span>.<br/>We start at eight.</p>
      <p begin="00:00:07.000" end="00:00:09.000" region="bottom" style="Thoughts" tts:textAlign="center">Why does he always say that?</p>
      <p begin="00:00:08.500" end="00:00:10.000" region="bottom" style="Default" tts:textAlign="center"><span tts:fontWeight="bold">Hurry</span> &amp; bring the &lt;notes&gt;!</p>
      <p begin="00:00:11.000" end="00:00:13.000" region="bottom" style="Default" tts:textAlign="center"><span tts:textDecoration="underline noLineThrough">Chapter one</span></p>
      <p begin="00:00:15.000" end="00:00:17.250" region="bottom" style="Default" tts:textAlign="center"><span tts:textDecoration="noUnderline lineThrough">Wrong</span> Right, see you <span tts:color="#FFFF00">tomorrow</span>.</p>
    </div>
  </body>
</tt>
