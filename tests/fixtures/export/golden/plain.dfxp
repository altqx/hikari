<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en" ttp:frameRate="24" ttp:frameRateMultiplier="1000 1001">
  <head>
    <styling>
      <style xml:id="Default" tts:fontFamily="Arial,proportionalSansSerif" tts:fontSize="100%" tts:color="#FFFFFFFF" tts:textOutline="#000000FF 0.04em"/>
      <style xml:id="Thoughts" tts:fontFamily="Arial,proportionalSansSerif" tts:fontSize="100%" tts:color="#FFFFFFFF" tts:fontStyle="italic" tts:textOutline="#000000FF 0.04em"/>
    </styling>
    <layout>
      <region xml:id="bottom" tts:origin="3.12% 65.12%" tts:extent="93.75% 30.24%" tts:displayAlign="after"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="24f" end="84f" region="bottom" style="Default" tts:textAlign="center">Good morning.</p>
      <p begin="96f" end="149f" region="bottom" style="Default" tts:textAlign="center">You're late <span tts:fontStyle="italic">again</span>.<br/>We start at eight.</p>
      <p begin="168f" end="216f" region="bottom" style="Thoughts" tts:textAlign="center">Why does he always say that?</p>
      <p begin="204f" end="240f" region="bottom" style="Default" tts:textAlign="center"><span tts:fontWeight="bold">Hurry</span> &amp; bring the &lt;notes&gt;!</p>
      <p begin="264f" end="312f" region="bottom" style="Default" tts:textAlign="center"><span tts:textDecoration="underline noLineThrough">Chapter one</span></p>
      <p begin="360f" end="414f" region="bottom" style="Default" tts:textAlign="center"><span tts:textDecoration="noUnderline lineThrough">Wrong</span> Right, see you <span tts:color="#FFFF00">tomorrow</span>.</p>
    </div>
  </body>
</tt>
