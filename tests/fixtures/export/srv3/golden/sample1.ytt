" bo="254" /><pen id="34" sz="100" fc="#E35A94" fo="254" bc="#FFFFFF" bo="254" /><pen id="35" sz="100" fc="#FEFEFE" fo="254" bc="#424242" bo="254" /><pen id="36" sz="100" fc="#E6699D" fo="254" bc="#FFFFFF" bo="254" /><pen id="37" sz="100" fc="#FEFEFE" fo="254" bc="#565656" bo="254" /><pen id="38" sz="100" fc="#E877A7" fo="254" bc="#FFFFFF" bo="254" /><pen id="39" sz="100" fc="#FEFEFE" fo="254" bc="#6B6B6B" bo="254" /><pen id="40" sz="100" fc="#EA86B0" fo="254" bc="#FFFFFF" bo="254" /><pen id="41" sz="100" fc="#FEFEFE" fo="254" bc="#7F7F7F" bo="254" /><pen id="42" sz="100" fc="#ED95BA" fo="254" bc="#FFFFFF" bo="254" /><pen id="43" sz="100" fc="#FEFEFE" fo="254" bc="#939393" bo="254" /><pen id="44" sz="100" fc="#EFA3C3" fo="254" bc="#FFFFFF" bo="254" /><pen id="45" sz="100" fc="#FEFEFE" fo="254" bc="#A8A8A8" bo="254" /><pen id="46" sz="100" fc="#F2B2CD" fo="254" bc="#FFFFFF" bo="254" /><pen id="47" sz="100" fc="#FEFEFE" fo="254" bc="#BCBCBC" bo="254" /><pen id="48" sz="100" fc="#F4C0D6" fo="254" bc="#FFFFFF" bo="254" /><pen id="49" sz="100" fc="#FEFEFE" fo="254" bc="#D1D1D1" bo="254" /><pen id="50" sz="100" fc="#F7CFE0" fo="254" bc="#FFFFFF" bo="254" /><pen id="51" sz="100" fc="#FEFEFE" fo="254" bc="#E5E5E5" bo="254" /><pen id="52" sz="100" fc="#F9DEE9" fo="254" bc="#FFFFFF" bo="254" /><pen id="53" sz="100" fc="#FEFEFE" fo="254" bc="#F9F9F9" bo="254" /><pen id="54" sz="100" fc="#FBECF3" fo="254" bc="#FFFFFF" bo="254" /><pen id="55" sz="100" fc="#FEFBFC" fo="254" bc="#FFFFFF" bo="254" /><pen id="56" sz="0" fc="#A0AAB4" fo="0" bo="0" /><pen id="57" sz="0" fc="#FEFEFE" fo="254" bc="#000000" bo="95" /><pen id="58" sz="0" fc="#E35792" fo="254" bc="#000000" bo="95" /><pen id="59" sz="0" fc="#0C95C4" fo="254" bc="#000000" bo="95" /><pen id="60" sz="100" fc="#FEFEFE" fo="254" bc="#9D040F" bo="254" et="4" ec="#000000" /></head><body><p t="250" d="1769" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​Haooo! HimeHina here!​ ​</s><s p="1">​
​</s><s p="3">​ ​Haooo! HimeHina here!​ ​</s><s p="1">​</s></p><p t="2019" d="968" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​This time!​ ​</s><s p="1">​</s></p><p t="2987" d="3136" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​We’re going to answer the questions we got in our question box,​ ​</s><s p="1">​</s></p><p t="6123" d="767" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​except!​ ​</s><s p="1">​</s></p><p t="6890" d="768" wp="1" ws="1"><s p="1">​</s>​<s p="3">​ ​Except?​ ​</s><s p="1">​</s></p><p t="7658" d="1301" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​We’ll answer in rap​ ​</s><s p="1">​</s></p><p t="8959" d="1168" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​Answering questions​ ​</s><s p="1">​
​</s><s p="3">​ ​Answering questions​ ​</s><s p="1">​</s></p><p t="10127" d="2836" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​while rapping!​ ​</s><s p="1">​
​</s><s p="3">​ ​while rapping!​ ​</s><s p="1">​</s></p><p t="13897" d="1402" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​Rapping!​ ​</s><s p="1">​</s></p><p t="16700" d="1635" wp="1" ws="1"><s p="1">​</s>​<s p="3">​ ​This pumping beat​ ​</s><s p="1">​</s></p><p t="18335" d="1301" wp="1" ws="1"><s p="1">​</s>​<s p="3">​ ​This swinging heart​ ​</s><s p="1">​</s></p><p t="19636" d="968" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​Heart, T, T...​ ​</s><s p="1">​</s></p><p t="20604" d="1068" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​Tick the boxes​ ​</s><s p="1">​</s></p><p t="21672" d="1702" wp="2" ws="1"><s p="1">​</s>​<s p="4">​ ​Shiritori​ ​</s><s p="1">​</s></p><p t="27811" d="1936" wp="1" ws="1"><s p="1">​</s>​<s p="3">​ ​I have some questions I want to ask you​ ​</s><s p="1">​</s></p><p t="29747" d="1935" wp="1" ws="1"><s p="1">​</s>​<s p="3">​ ​Answer them while rapping as you should do​ ​</s><s p="1">​</s></p><p t="31682" d="2102" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​Ordinary rap can go far away​ ​</s><s p="1">​</s></p><p t="33784" d="1969" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​We’re doing giggle rap, HimeHina​ ​</s><s p="1">​</s></p><p t="35753" d="2002" wp="1" ws="1"><s p="1">​</s>​<s p="3">​ ​One, two​ ​</s><s p="1">​</s></p><p t="37755" d="1901" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​Are you ready?​ ​</s><s p="1">​
​</s><s p="3">​ ​Are you ready?​ ​</s><s p="1">​</s></p><p t="39656" d="2069" wp="1" ws="1"><s p="1">​</s>​<s p="5">​ ​What is your favorite special day?​ ​</s><s p="1">​</s></p><p t="41725" d="2002" wp="3" ws="2"><s p="6">​</s>​<s p="7">​ ​Let’s listen​ ​</s><s p="6">​</s></p><p t="42259" d="1468" wp="4" ws="2"><s p="6">​</s>​<s p="7">​ ​to what Hime​ ​</s><s p="6">​</s></p><p t="42760" d="967" wp="5" ws="2"><s p="6">​</s>​<s p="7">​ ​has to say!​ ​</s><s p="6">​</s></p><p t="43727" d="2036" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​Alright, leave it to me, this one’s easy​ ​</s><s p="1">​</s></p><p t="45763" d="1968" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​Goes without saying that it’s the Hinamatsuri!​ ​</s><s p="1">​</s></p><p t="47731" d="2002" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​Third day of third month, festival of peaches​ ​</s><s p="1">​</s></p><p t="49733" d="2036" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​Wishing for little girls’ health and fitness!​ ​</s><s p="1">​</s></p><p t="51769" d="2002" wp="6" ws="2"><s p="6">​</s>​<s p="7">​ ​Nice one​ ​</s><s p="6">​</s></p><p t="52269" d="1502" wp="7" ws="2"><s p="6">​</s>​<s p="7">​ ​Nice one​ ​</s><s p="6">​</s></p><p t="52736" d="1035" wp="8" ws="2"><s p="6">​</s>​<s p="7">​ ​That’s a nice one​ ​</s><s p="6">​</s></p><p t="53771" d="1935" wp="1" ws="1"><s p="1">​</s>​<s p="5">​ ​Now tell us how you like your ramen done!​ ​</s><s p="1">​</s></p><p t="55706" d="2035" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​Lots of types are going ‘round, so what ramen?​ ​</s><s p="1">​</s></p><p t="57741" d="1969" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​The one I like most would be tonkotsu, yeah​ ​</s><s p="1">​</s></p><p t="59710" d="2069" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​Pictures at midnight make me so hungry​ ​</s><s p="1">​</s></p><p t="61779" d="1968" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​Ramen, Tsukemen, Tanaka Himen!​ ​</s><s p="1">​</s></p><p t="63747" d="2002" wp="9" ws="2"><s p="6">​</s>​<s p="7">​ ​This here​ ​</s><s p="6">​</s></p><p t="64281" d="1468" wp="10" ws="2"><s p="6">​</s>​<s p="7">​ ​is the next​ ​</s><s p="6">​</s></p><p t="64748" d="1001" wp="11" ws="2"><s p="6">​</s>​<s p="7">​ ​question I got for ya​ ​</s><s p="6">​</s></p><p t="65749" d="1969" wp="1" ws="1"><s p="1">​</s>​<s p="5">​ ​What angle should a comaneci be performed at?​ ​</s><s p="1">​</s></p><p t="67718" d="1535" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​This is really important to me so listen close​ ​</s><s p="1">​</s></p><p t="69253" d="1535" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​I do a lotta cool comanecis in the Roki video,​ ​</s><s p="1">​</s></p><p t="70788" d="934" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​well that’s the ideal​ ​</s><s p="1">​</s></p><p t="71722" d="2035" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​The sign of V is 45°​ ​</s><s p="1">​</s></p><p t="73757" d="1969" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​Bring your hands up, move diagonally​ ​</s><s p="1">​</s></p><p t="75726" d="2035" wp="12" ws="2"><s p="6">​</s>​<s p="7">​ ​About those​ ​</s><s p="6">​</s></p><p t="76260" d="1501" wp="13" ws="2"><s p="6">​</s>​<s p="7">​ ​gigglebuns you​ ​</s><s p="6">​</s></p><p t="76760" d="1001" wp="11" ws="2"><s p="6">​</s>​<s p="7">​ ​have on your head​ ​</s><s p="6">​</s></p><p t="77761" d="1935" wp="1" ws="1"><s p="1">​</s>​<s p="5">​ ​Do you normally tie those up yourself?​ ​</s><s p="1">​</s></p><p t="79696" d="1936" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​Hina does that for me at morning​ ​</s><s p="1">​</s></p><p t="81632" d="901" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​Right? Hina​ ​</s><s p="1">​</s></p><p t="82533" d="1067" wp="1" ws="1"><s p="1">​</s>​<s p="3">​ ​I do​ ​</s><s p="1">​</s></p><p t="83600" d="2136" wp="1" ws="1"><s p="1">​</s>​<s p="3">​ ​I shake her awake in bed every time in the morning​ ​</s><s p="1">​</s></p><p t="85736" d="1968" wp="1" ws="1"><s p="1">​</s>​<s p="3">​ ​and then tie her hair into neat gigglebuns​ ​</s><s p="1">​</s></p><p t="88639" d="1768" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​Now it’s your turn, Hina!​ ​</s><s p="1">​</s></p><p t="90407" d="1568" wp="1" ws="1"><s p="1">​</s>​<s p="3">​ ​Mic check, one, okay​ ​</s><s p="1">​</s></p><p t="91975" d="701" wp="1" ws="1"><s p="1">​</s>​<s p="3">​ ​It’s my turn​ ​</s><s p="1">​</s></p><p t="94945" d="1802" wp="14" ws="3"><s p="6">​</s>​<s p="7">​ ​Let’s go then​ ​</s><s p="6">​</s></p><p t="95412" d="1335" wp="15" ws="3"><s p="6">​</s>​<s p="7">​ ​Answer me​ ​</s><s p="6">​</s></p><p t="95879" d="868" wp="16" ws="3"><s p="6">​</s>​<s p="7">​ ​this nice question over here​ ​</s><s p="6">​</s></p><p t="96747" d="1601" wp="1" ws="1"><s p="1">​</s>​<s p="5">​ ​What is your English word of the year?​ ​</s><s p="1">​</s></p><p t="98348" d="2036" wp="1" ws="1"><s p="1">​</s>​<s p="3">​ ​English is not in my zone, but anyway​ ​</s><s p="1">​</s></p><p t="100384" d="1334" wp="1" ws="1"><s p="1">​</s>​<s p="3">​ ​If I had to pick, it be PSYCHO-PASS​ ​</s><s p="1">​</s></p><p t="101718" d="1902" wp="1" ws="1"><s p="1">​</s>​<s p="3">​ ​Any place you go, get a free pass​ ​</s><s p="1">​</s></p><p t="102820" d="800" wp="17" ws="1"><s p="1">​</s>​<s p="4">​ ​※ Just wanted to say it​ ​</s><s p="1">​</s></p><p t="103620" d="1669" wp="1" ws="1"><s p="1">​</s>​<s p="3">​ ​Being VIP sounds amazing, right?​ ​</s><s p="1">​</s></p><p t="105289" d="1668" wp="1" ws="1"><s p="1">​</s>​<s p="5">​ ​Suzuki Hina Hinna​ ​</s><s p="1">​</s></p><p t="106957" d="634" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​HinaHina​ ​</s><s p="1">​</s></p><p t="107591" d="934" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​Is this a question?​ ​</s><s p="1">​</s></p><p t="108525" d="1535" wp="1" ws="1"><s p="1">​</s>​<s p="3">​ ​Is that from Golden Kamuy?​ ​</s><s p="1">​</s></p><p t="110060" d="1935" wp="1" ws="1"><s p="1">​</s>​<s p="3">​ ​“Hinna” means “thanks a lot” in Ainu​ ​</s><s p="1">​</s></p><p t="111228" d="1935" wp="18" ws="1"><s p="1">​</s>​<s p="4">​ ​“Hinna” expresses gratitude in the Ainu language​ ​</s><s p="1">​</s></p><p t="111995" d="1168" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​So Suzuki Thanks Thanks?​ ​</s><s p="1">​</s></p><p t="113163" d="2369" wp="1" ws="1"><s p="1">​</s>​<s p="3">​ ​It’s closer to “thanks for the food”​ ​</s><s p="1">​</s></p><p t="115532" d="1769" wp="1" ws="1"><s p="1">​</s>​<s p="5">​ ​Uho Uho Uhohoho​ ​</s><s p="1">​</s></p><p t="117301" d="801" wp="1" ws="1"><s p="1">​</s>​<s p="5">​ ​KYAAI! KYAAI!​ ​</s><s p="1">​</s></p><p t="118102" d="900" wp="1" ws="1"><s p="1">​</s>​<s p="5">​ ​AH AH AH​ ​</s><s p="1">​</s></p><p t="119002" d="1702" wp="19" ws="1"><s p="1">​</s>​<s p="8">​ ​Uho​ ​</s><s p="1">​</s></p><p t="119470" d="1234" wp="20" ws="1"><s p="1">​</s>​<s p="8">​ ​Uho​ ​</s><s p="1">​</s></p><p t="119937" d="767" wp="21" ws="1"><s p="1">​</s>​<s p="8">​ ​Uhoho?​ ​</s><s p="1">​</s></p><p t="120704" d="1769" wp="22" ws="1"><s p="1">​</s>​<s p="9">​ ​Uhho​ ​</s><s p="1">​</s></p><p t="121105" d="1368" wp="23" ws="1"><s p="1">​</s>​<s p="9">​ ​Uhho​ ​</s><s p="1">​</s></p><p t="121638" d="835" wp="24" ws="1"><s p="1">​</s>​<s p="9">​ ​Uhohoho​ ​</s><s p="1">​</s></p><p t="122473" d="1134" wp="25" ws="1"><s p="1">​</s>​<s p="9">​ ​Uhho​ ​</s><s p="1">​</s></p><p t="122940" d="667" wp="26" ws="1"><s p="1">​</s>​<s p="9">​ ​Uhho​ ​</s><s p="1">​</s></p><p t="123273" d="334" wp="27" ws="1"><s p="1">​</s>​<s p="9">​ ​Uhohoho​ ​</s><s p="1">​</s></p><p t="123607" d="1702" wp="1" ws="1"><s p="1">​</s>​<s p="3">​ ​I’m trying to rap here, please be quiet​ ​</s><s p="1">​</s></p><p t="125309" d="534" wp="1" ws="1"><s p="1">​</s>​<s p="2">​ ​Sorry​ ​</s><s p="1">​</s></p><p t="125843" d="1735" wp="1" ws="1"><s p="1">​</s>​<s p="5">​ ​“Hey, are you good at rapping?”, they ask​ ​</s><s p="1">​</s></p><p t="127578" d="1701" wp="28" ws="3"><s p="6">​</s>​<s p="7">​ ​Go ahead and​ ​</s><s p="6">​</s></p><p t="128011" d="1268" wp="15" ws="3"><s p="6">​</s>​<s p="7">​ ​show them​ ​</s><s p="6">​</s></p><p t="12