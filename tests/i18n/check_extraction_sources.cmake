# Every source under src/ that calls a translation function is one lupdate
# reads: the sources Qt's qt_add_lupdate recorded for hikari_lupdate (the
# targets in i18n/Extraction.cmake). A library or QML module added later
# with qsTr/tr calls but left out of that list would otherwise be skipped by
# extraction, and the next hikari_lupdate would obsolete its keys.
file(READ "${PROJECT_JSON}" json)

set(extracted "")
function(collect project)
    string(JSON count ERROR_VARIABLE absent LENGTH "${project}" sources)
    if(NOT absent AND count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(i RANGE ${last})
            string(JSON file GET "${project}" sources ${i})
            list(APPEND extracted "${file}")
        endforeach()
    endif()
    string(JSON count ERROR_VARIABLE absent LENGTH "${project}" subProjects)
    if(NOT absent AND count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(i RANGE ${last})
            string(JSON sub GET "${project}" subProjects ${i})
            collect("${sub}")
        endforeach()
    endif()
    set(extracted "${extracted}" PARENT_SCOPE)
endfunction()
collect("${json}")
list(LENGTH extracted extracted_count)
if(extracted_count EQUAL 0)
    message(FATAL_ERROR "no sources in ${PROJECT_JSON}")
endif()

file(GLOB_RECURSE candidates "${SOURCE_DIR}/src/*.cpp" "${SOURCE_DIR}/src/*.h" "${SOURCE_DIR}/src/*.qml" "${SOURCE_DIR}/src/*.js")
set(calling 0)
set(missing "")
foreach(file IN LISTS candidates)
    file(STRINGS "${file}" calls REGEX "(^|[^A-Za-z0-9_])(qsTr|qsTranslate|qsTrId|qsTrNoOp|qsTranslateNoOp|QT_TR_NOOP|QT_TR_N_NOOP|QT_TRANSLATE_NOOP|QT_TRANSLATE_N_NOOP|QT_TRID_NOOP|tr|translate)[ \t]*\\(")
    if(calls)
        math(EXPR calling "${calling} + 1")
        list(FIND extracted "${file}" index)
        if(index EQUAL -1)
            list(APPEND missing "${file}")
        endif()
    endif()
endforeach()
if(missing)
    list(JOIN missing "\n  " missing)
    message(FATAL_ERROR "sources with translation calls that hikari_lupdate does not read "
        "(add their target to HIKARI_I18N_SOURCE_TARGETS in i18n/Extraction.cmake):\n  ${missing}")
endif()
message(STATUS "${calling} sources with translation calls, all among the ${extracted_count} hikari_lupdate reads")
