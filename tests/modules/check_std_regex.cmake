#   cmake -DROOT=<tree> -P check_std_regex.cmake
cmake_minimum_required(VERSION 3.28)
if(NOT ROOT)
    message(FATAL_ERROR "ROOT is required")
endif()

set(globs "")
foreach(dir src tests)
    foreach(ext c cc cpp cxx h hh hpp hxx inl mm)
        list(APPEND globs "${ROOT}/${dir}/*.${ext}")
    endforeach()
endforeach()
file(GLOB_RECURSE sources RELATIVE "${ROOT}" ${globs})
list(FILTER sources EXCLUDE REGEX "^tests/modules/[^/]+-violation/")
set(failures "")
foreach(source IN LISTS sources)
    file(STRINGS "${ROOT}/${source}" lines REGEX "#[ \t]*include[ \t]*<regex>|std::[a-z_]*regex|std::w?[cs]match")
    foreach(line IN LISTS lines)
        string(STRIP "${line}" line)
        string(APPEND failures "\n  ${source}: ${line}")
    endforeach()
endforeach()
if(failures)
    message(FATAL_ERROR "std::regex is banned; use hikari/regex/regex.h:${failures}")
endif()
message(STATUS "No std::regex under src/ or tests/")
