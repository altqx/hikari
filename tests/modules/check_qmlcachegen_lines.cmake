include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/HikariCommandLines.cmake")
set(build "/build")
set(qrc_files "${build}/src/ui/.qt/rcc/qmake_Hikari_Ui.qrc")
if(CASE STREQUAL "violation")
    set(count 75)
else()
    set(count 7)
endif()
foreach(i RANGE 1 ${count})
    list(APPEND qrc_files "${build}/src/ui/.qt/rcc/hikari_ui_raw_qml_${i}.qrc")
endforeach()
hikari_qmlcachegen_line_problem(hikari_ui "${qrc_files}" "${build}" problem)
if(problem)
    message(FATAL_ERROR "${problem}")
endif()
