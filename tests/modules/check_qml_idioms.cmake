#   cmake -DROOT=<tree> -P check_qml_idioms.cmake
cmake_minimum_required(VERSION 3.28)
if(NOT ROOT)
    message(FATAL_ERROR "ROOT is required")
endif()

set(nested "([^()]|\\(([^()]|\\(([^()]|\\([^()]*\\))*\\))*\\))*")
set(chained_arg "\\.arg\\(${nested}\\)[ \t\r\n]*\\.arg\\(")
set(hand_escape "replace\\(/&/g, *[\"']&amp")

file(GLOB_RECURSE sources RELATIVE "${ROOT}" "${ROOT}/src/*.qml" "${ROOT}/src/*.js" "${ROOT}/src/*.mjs")
set(failures "")
foreach(source IN LISTS sources)
    file(READ "${ROOT}/${source}" text)
    string(REPLACE ";" "," text "${text}")
    string(REGEX MATCHALL "${chained_arg}" chains "${text}")
    foreach(chain IN LISTS chains)
        string(REGEX REPLACE "[ \t\r\n]+" " " chain "${chain}")
        string(APPEND failures "\n  ${source}: ${chain} (a chain substitutes %n inside earlier arguments; use .arg(a, b))")
    endforeach()
    string(REGEX MATCHALL "${hand_escape}[^\n]*" escapes "${text}")
    foreach(escape IN LISTS escapes)
        string(APPEND failures "\n  ${source}: ${escape} (use Qt.escapeHtml)")
    endforeach()
endforeach()
if(failures)
    message(FATAL_ERROR "QML text built the pre-6.12 way:${failures}")
endif()
message(STATUS "QML substitutes and escapes text with Qt 6.12's String.arg and Qt.escapeHtml")
