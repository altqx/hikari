#   cmake -DROOT=<tree> -P check_qml_debug.cmake
if(NOT ROOT)
    message(FATAL_ERROR "ROOT is required")
endif()

file(READ "${ROOT}/CMakePresets.json" presets)
string(JSON configure_count LENGTH "${presets}" configurePresets)
math(EXPR configure_last "${configure_count} - 1")

set(debug_presets "")
set(grew TRUE)
while(grew)
    set(grew FALSE)
    foreach(i RANGE ${configure_last})
        string(JSON name GET "${presets}" configurePresets ${i} name)
        if(name IN_LIST debug_presets)
            continue()
        endif()
        string(JSON preset GET "${presets}" configurePresets ${i})
        set(debug FALSE)
        string(JSON hot ERROR_VARIABLE missing GET "${preset}" cacheVariables HIKARI_QML_HOT_RELOAD)
        if(NOT missing AND hot MATCHES "^{")
            string(JSON hot ERROR_VARIABLE missing GET "${hot}" value)
        endif()
        if(NOT missing AND hot)
            set(debug TRUE)
        endif()
        if(preset MATCHES "QT_QML_DEBUG|QT_ENABLE_QML_DEBUG")
            set(debug TRUE)
        endif()
        string(JSON parents ERROR_VARIABLE missing GET "${preset}" inherits)
        if(NOT missing)
            string(REGEX REPLACE "[][\" \n]" "" parents "${parents}")
            string(REPLACE "," ";" parents "${parents}")
            foreach(parent IN LISTS parents)
                if(parent IN_LIST debug_presets)
                    set(debug TRUE)
                endif()
            endforeach()
        endif()
        if(debug)
            list(APPEND debug_presets "${name}")
            set(grew TRUE)
        endif()
    endforeach()
endwhile()

set(failures "")
foreach(kind testPresets workflowPresets)
    string(JSON count ERROR_VARIABLE missing LENGTH "${presets}" ${kind})
    if(missing OR count EQUAL 0)
        continue()
    endif()
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON preset GET "${presets}" ${kind} ${i})
        string(JSON name GET "${preset}" name)
        foreach(debug IN LISTS debug_presets)
            if(preset MATCHES "\"${debug}\"")
                string(APPEND failures "\n  ${kind} ${name} uses ${debug}")
            endif()
        endforeach()
    endforeach()
endforeach()

string(JOIN "|" shipped_words ${debug_presets} HIKARI_QML_HOT_RELOAD QT_QML_DEBUG QT_ENABLE_QML_DEBUG)
file(GLOB_RECURSE shipping RELATIVE "${ROOT}" "${ROOT}/.github/*" "${ROOT}/packaging/*" "${ROOT}/cmake/*")
foreach(file IN LISTS shipping)
    file(STRINGS "${ROOT}/${file}" lines REGEX "${shipped_words}")
    foreach(line IN LISTS lines)
        string(STRIP "${line}" line)
        string(APPEND failures "\n  ${file}: ${line}")
    endforeach()
endforeach()

if(failures)
    message(FATAL_ERROR "QML debugging (${debug_presets}) reaches CI, tests or packages:${failures}")
endif()
message(STATUS "QML debugging stays in the development presets: ${debug_presets}")
