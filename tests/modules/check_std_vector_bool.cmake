#   cmake -DROOT=<tree> -P check_std_vector_bool.cmake
cmake_minimum_required(VERSION 3.28)
if(NOT ROOT)
    message(FATAL_ERROR "ROOT is required")
endif()

set(globs "")
foreach(ext c cc cpp cxx h hh hpp hxx inl mm)
    list(APPEND globs "${ROOT}/src/*.${ext}")
endforeach()
file(GLOB_RECURSE sources RELATIVE "${ROOT}" ${globs})
set(failures "")
foreach(source IN LISTS sources)
    file(STRINGS "${ROOT}/${source}" lines REGEX "vector[ \t]*<[ \t]*bool[ \t]*>")
    foreach(line IN LISTS lines)
        string(STRIP "${line}" line)
        string(APPEND failures "\n  ${source}: ${line}")
    endforeach()
endforeach()
if(failures)
    message(FATAL_ERROR "std::vector<bool> is banned under src/; use boost::dynamic_bitset:${failures}")
endif()
message(STATUS "No std::vector<bool> under src/")
