#   cmake -DROOT=<tree> -P check_std_unordered.cmake
cmake_minimum_required(VERSION 3.28)
if(NOT ROOT)
    message(FATAL_ERROR "ROOT is required")
endif()

set(globs "")
foreach(ext c cc cpp cxx h hh hpp hxx inl mm)
    list(APPEND globs "${ROOT}/src/*.${ext}")
endforeach()
file(GLOB_RECURSE sources RELATIVE "${ROOT}" ${globs})
set(failures "")
foreach(source IN LISTS sources)
    file(STRINGS "${ROOT}/${source}" lines REGEX "#[ \t]*include[ \t]*<unordered_(map|set)>|std::unordered_(multi)?(map|set)")
    foreach(line IN LISTS lines)
        string(STRIP "${line}" line)
        string(APPEND failures "\n  ${source}: ${line}")
    endforeach()
endforeach()
if(failures)
    message(FATAL_ERROR "std::unordered_map and std::unordered_set are banned under src/; use absl::flat_hash_map or absl::flat_hash_set:${failures}")
endif()
message(STATUS "No std::unordered_map or std::unordered_set under src/")
