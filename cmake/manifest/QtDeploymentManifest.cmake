# Checks packaging/qt-deployment.json: every platform lists the required plugins, each plugin's Qt module archive is
# in that platform's Qt lock, and here each plugin file is in the provisioned Qt. Writes the resolved files to OUT.
#
#   cmake -DMANIFEST=<qt-deployment.json> -DLOCKS=<cmake/locks> -DPLUGINS=<Qt plugins dir>
#         -DPLATFORM=linux|windows -DOUT=<resolved.json> -P QtDeploymentManifest.cmake
cmake_minimum_required(VERSION 3.28)
foreach(var MANIFEST LOCKS PLUGINS PLATFORM OUT)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "QtDeploymentManifest: ${var} is required")
    endif()
endforeach()
set(problems "")
file(READ "${MANIFEST}" manifest)

# Named here, not in the manifest, so the data under check cannot drop them.
set(required imageformats/qsvg iconengines/qsvgicon)

# The members of a JSON object or the length of an array at PATH..., 0 when
# it is empty or absent ("foreach(RANGE -1)" would still run).
function(json_length out)
    string(JSON n ERROR_VARIABLE missing LENGTH "${manifest}" ${ARGN})
    if(missing)
        set(n 0)
    endif()
    set(${out} ${n} PARENT_SCOPE)
endfunction()

set(platforms "")
json_length(platform_count platforms)
if(platform_count GREATER 0)
    math(EXPR last "${platform_count} - 1")
    foreach(i RANGE ${last})
        string(JSON platform MEMBER "${manifest}" platforms ${i})
        list(APPEND platforms "${platform}")
    endforeach()
endif()
foreach(platform linux windows)
    if(NOT platform IN_LIST platforms)
        list(APPEND problems "no ${platform} manifest")
    endif()
endforeach()

set(resolved_json "")
foreach(platform IN LISTS platforms)
    # The Qt module archives of this platform's lock (6.11.2-0-<stamp>qtsvg-<host>.7z -> qtsvg).
    set(lock_file "${LOCKS}/qt-${platform}.lock.json")
    set(modules "")
    if(EXISTS "${lock_file}")
        file(READ "${lock_file}" lock)
        string(JSON object_count ERROR_VARIABLE no_objects LENGTH "${lock}" objects)
        if(no_objects OR object_count EQUAL 0)
            list(APPEND problems "${platform}: the Qt lock ${lock_file} lists no objects")
            set(object_count 0)
        endif()
        if(object_count GREATER 0)
            math(EXPR last_object "${object_count} - 1")
            foreach(k RANGE ${last_object})
                string(JSON kind GET "${lock}" objects ${k} kind)
                if(NOT kind STREQUAL "payload")
                    continue()
                endif()
                string(JSON path GET "${lock}" objects ${k} path)
                get_filename_component(archive "${path}" NAME)
                if(archive MATCHES "^[0-9.]+-[0-9]+-[0-9]+(qt[a-z0-9]+)-")
                    list(APPEND modules "${CMAKE_MATCH_1}")
                endif()
            endforeach()
        endif()
        list(REMOVE_DUPLICATES modules)
    else()
        list(APPEND problems "${platform}: no Qt lock ${lock_file}")
    endif()

    set(listed "")
    set(files_json "")
    json_length(category_count platforms ${platform})
    if(category_count EQUAL 0)
        list(APPEND problems "${platform}: the manifest lists no plugin category")
    endif()
    math(EXPR last_category "${category_count} - 1")
    foreach(c RANGE ${last_category})
        if(category_count EQUAL 0)
            break()
        endif()
        string(JSON category MEMBER "${manifest}" platforms ${platform} ${c})
        json_length(entry_count platforms ${platform} "${category}")
        if(entry_count EQUAL 0)
            list(APPEND problems "${platform}: ${category} lists no plugin")
            continue()
        endif()
        math(EXPR last_entry "${entry_count} - 1")
        foreach(e RANGE ${last_entry})
            string(JSON name GET "${manifest}" platforms ${platform} "${category}" ${e} plugin)
            string(JSON module GET "${manifest}" platforms ${platform} "${category}" ${e} module)
            string(JSON why ERROR_VARIABLE no_why GET "${manifest}" platforms ${platform} "${category}" ${e} why)
            if(no_why OR why STREQUAL "")
                list(APPEND problems "${platform}: ${category}/${name} says not why it ships")
            endif()
            list(APPEND listed "${category}/${name}")
            if(NOT module IN_LIST modules)
                list(APPEND problems "${platform}: ${category}/${name} comes from ${module}, which the Qt lock does not install")
            endif()
            if(platform STREQUAL "windows")
                set(file "${category}/${name}.dll")
            else()
                set(file "${category}/lib${name}.so")
            endif()
            if(platform STREQUAL PLATFORM)
                if(EXISTS "${PLUGINS}/${file}")
                    file(SHA256 "${PLUGINS}/${file}" sha)
                    string(APPEND files_json "    {\"file\": \"plugins/${file}\", \"module\": \"${module}\", \"sha256\": \"${sha}\"},\n")
                else()
                    list(APPEND problems "${platform}: ${file} is not in the provisioned Qt (${PLUGINS})")
                endif()
            endif()
        endforeach()
    endforeach()
    foreach(plugin IN LISTS required)
        if(NOT plugin IN_LIST listed)
            list(APPEND problems "${platform}: the manifest does not carry ${plugin}, which every package needs")
        endif()
    endforeach()
    if(platform STREQUAL PLATFORM)
        string(REGEX REPLACE ",\n$" "\n" files_json "${files_json}")
        set(resolved_json "${files_json}")
    endif()
endforeach()
if(NOT PLATFORM IN_LIST platforms)
    list(APPEND problems "no manifest for ${PLATFORM}, the platform this runs on")
endif()

file(WRITE "${OUT}" "{\n  \"platform\": \"${PLATFORM}\",\n  \"plugins\": [\n${resolved_json}  ]\n}\n")
if(problems)
    list(JOIN problems "\n  " text)
    message(FATAL_ERROR "FAIL: the Qt deployment manifest is incomplete:\n  ${text}")
endif()
list(JOIN required ", " required_text)
message(STATUS "PASS Qt deployment manifest (${platforms}; every package carries ${required_text}); ${OUT}")
