# Bun, upstream's baseline x86-64 release builds pinned by SHA-256 (archive and binary). The host's copy runs the
# sidecar's install, tests and build; each target's copy is the runtime `bun build --compile` embeds.
#
#   hikari_fetch_bun(<downloads> <platform> <out-var>)   <platform> is linux-x64 or windows-x64
#   cmake -DDOWNLOADS=<dir> [-DPLATFORM=<platform>] -P cmake/HikariBun.cmake
include_guard(GLOBAL)

set(HIKARI_BUN_VERSION "1.4.4")
set(HIKARI_BUN_RELEASE_URL "https://github.com/oven-sh/bun/releases/download/bun-v${HIKARI_BUN_VERSION}")
set(HIKARI_BUN_linux-x64_ARCHIVE "bun-linux-x64-baseline.zip")
set(HIKARI_BUN_linux-x64_ARCHIVE_SHA256 "e0446eb55995772eb9894bebae9a6be368d985a8b9271ee124486f9946eedd76")
set(HIKARI_BUN_linux-x64_MEMBER "bun-linux-x64-baseline/bun")
set(HIKARI_BUN_linux-x64_SHA256 "10702245766b225e70bbf6235fd6b47214fd94b4760d00ffaed8ab0df57ac235")
set(HIKARI_BUN_windows-x64_ARCHIVE "bun-windows-x64-baseline.zip")
set(HIKARI_BUN_windows-x64_ARCHIVE_SHA256 "0f20ce6674d4f2dbcc8c5d59fdf99f7ba45f8c3b367e0f5781cbfa30a1c78d99")
set(HIKARI_BUN_windows-x64_MEMBER "bun-windows-x64-baseline/bun.exe")
set(HIKARI_BUN_windows-x64_SHA256 "cb1d8e6564e655e49d30cead359750a1cbbd12f42651caa4b62244d7bd93c244")

if(CMAKE_HOST_WIN32)
    set(HIKARI_BUN_HOST_PLATFORM "windows-x64")
else()
    set(HIKARI_BUN_HOST_PLATFORM "linux-x64")
endif()

function(hikari_fetch_bun downloads platform out)
    if(NOT DEFINED HIKARI_BUN_${platform}_ARCHIVE)
        message(FATAL_ERROR "Bun: no pinned build for ${platform}")
    endif()
    if(CMAKE_HOST_SYSTEM_PROCESSOR AND NOT CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
        message(FATAL_ERROR "Bun: the pinned Bun is for x86-64, not ${CMAKE_HOST_SYSTEM_PROCESSOR}")
    endif()
    set(name "${HIKARI_BUN_${platform}_ARCHIVE}")
    set(archive_sha256 "${HIKARI_BUN_${platform}_ARCHIVE_SHA256}")
    set(member "${HIKARI_BUN_${platform}_MEMBER}")
    set(sha256 "${HIKARI_BUN_${platform}_SHA256}")
    file(MAKE_DIRECTORY "${downloads}")
    set(archive "${downloads}/${HIKARI_BUN_VERSION}-${name}")
    if(EXISTS "${archive}")
        file(SHA256 "${archive}" have)
        if(NOT have STREQUAL archive_sha256)
            file(REMOVE "${archive}")
        endif()
    endif()
    if(NOT EXISTS "${archive}")
        file(DOWNLOAD "${HIKARI_BUN_RELEASE_URL}/${name}" "${archive}" EXPECTED_HASH SHA256=${archive_sha256}
            TLS_VERIFY ON STATUS status)
        list(GET status 0 code)
        if(NOT code EQUAL 0)
            file(REMOVE "${archive}")
            message(FATAL_ERROR "Bun: downloading ${name} failed: ${status}")
        endif()
    endif()
    set(dir "${downloads}/bun-${HIKARI_BUN_VERSION}-${platform}")
    set(binary "${dir}/${member}")
    set(have "")
    if(EXISTS "${binary}")
        file(SHA256 "${binary}" have)
    endif()
    if(NOT have STREQUAL sha256)
        file(REMOVE_RECURSE "${dir}")
        file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${dir}" PATTERNS "${member}")
        if(NOT EXISTS "${binary}")
            message(FATAL_ERROR "Bun: ${archive} has no ${member}")
        endif()
        file(SHA256 "${binary}" have)
        if(NOT have STREQUAL sha256)
            message(FATAL_ERROR "Bun: ${member} in ${archive} has SHA-256 ${have}, not ${sha256}")
        endif()
        file(CHMOD "${binary}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE
            WORLD_READ WORLD_EXECUTE)
    endif()
    set(${out} "${binary}" PARENT_SCOPE)
endfunction()

# The id the app and its sidecar must share: the version, plus the commit when the build knows it.
function(hikari_ai_build_id out)
    set(id "${HIKARI_VERSION}")
    if(HIKARI_COMMIT)
        string(SUBSTRING "${HIKARI_COMMIT}" 0 12 commit)
        string(APPEND id "+${commit}")
    endif()
    set(${out} "${id}" PARENT_SCOPE)
endfunction()

# HA1's kApiVersion, which the sidecar reports in `initialize`.
function(hikari_api_version out)
    file(STRINGS "${PROJECT_SOURCE_DIR}/src/api/include/hikari/api/api.h" line
        REGEX "inline constexpr int kApiVersion = [0-9]+")
    if(NOT line MATCHES "kApiVersion = ([0-9]+)")
        message(FATAL_ERROR "Bun: no kApiVersion in src/api/include/hikari/api/api.h")
    endif()
    set(${out} "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    if(NOT DOWNLOADS)
        message(FATAL_ERROR "usage: cmake -DDOWNLOADS=<dir> [-DPLATFORM=<platform>] -P ${CMAKE_CURRENT_LIST_FILE}")
    endif()
    if(NOT PLATFORM)
        set(PLATFORM "${HIKARI_BUN_HOST_PLATFORM}")
    endif()
    hikari_fetch_bun("${DOWNLOADS}" "${PLATFORM}" binary)
    message("${binary}")
endif()
