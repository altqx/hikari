diff --git i/libass/ass.h w/libass/ass.h
index 851ca7c..08fd140 100644
--- i/libass/ass.h
+++ w/libass/ass.h
@@ -360,6 +360,60 @@ void ass_process_force_style(ASS_Track *track);
  * \param msg_cb pointer to callback function
  * \param data additional data, will be passed to callback
  */
+/*
+ * Hikari font diagnostics (an owned overlay patch, not upstream libass).
+ * Reports which font bytes and faces the renderer actually used, so a
+ * collector can verify identity instead of trusting a name lookup. The
+ * callbacks run on the rendering thread, during rendering; the strings and
+ * the read function are valid only for the duration of the call.
+ */
+#define ASS_HIKARI_FONT_DIAGNOSTICS_VERSION 1
+
+typedef enum {
+    ASS_HIKARI_FONT_REQUESTED = 1,  // the requested family (or a provider substitution)
+    ASS_HIKARI_FONT_DEFAULT_FAMILY, // the configured default family
+    ASS_HIKARI_FONT_FALLBACK,       // the provider's glyph fallback
+    ASS_HIKARI_FONT_DEFAULT_PATH,   // the configured default font file
+} ASS_HikariFontStage;
+
+typedef struct ass_hikari_font_selection {
+    ASS_HikariFontStage stage;
+    const char *requested_family;   // may be NULL or empty
+    unsigned bold, italic;
+    uint32_t code;                  // the character that needed a face (0: none)
+    const char *path;               // NULL when the bytes come from a stream
+    const char *display_name;
+    const char *postscript_name;    // may be NULL
+    int index;                      // face index requested from the file or stream
+    int uid;                        // selector-local id; -1 for the default path
+    int embedded;                   // memory/attachment font (ass_add_font)
+    // Reads stream bytes; with data NULL returns the stream size. NULL for files.
+    size_t (*read)(void *read_data, unsigned char *data, size_t offset, size_t len);
+    void *read_data;
+} ASS_HikariFontSelection;
+
+typedef struct ass_hikari_font_diagnostics {
+    int version; // ASS_HIKARI_FONT_DIAGNOSTICS_VERSION
+    void (*selected)(void *priv, const ASS_HikariFontSelection *selection);
+    // After FreeType opened a selection: the actual face index (named-instance
+    // bits included), the file's face count and design coordinates, if any.
+    void (*face_opened)(void *priv, int uid, long face_index, long num_faces,
+                        const char *postscript_name, int n_coords, const double *coords);
+    // When a glyph is synthetically emboldened or slanted.
+    void (*glyph_simulated)(void *priv, int uid, unsigned glyph_index,
+                            int embolden, int italicize);
+    // When no available face has the character.
+    void (*glyph_missing)(void *priv, uint32_t code, const char *family,
+                          unsigned bold, unsigned italic);
+} ASS_HikariFontDiagnostics;
+
+/**
+ * \brief Install font diagnostics (copied; NULL or another version removes them).
+ */
+void ass_hikari_set_font_diagnostics(ASS_Library *priv,
+                                     const ASS_HikariFontDiagnostics *callbacks,
+                                     void *data);
+
 void ass_set_message_cb(ASS_Library *priv, void (*msg_cb)
                         (int level, const char *fmt, va_list args, void *data),
                         void *data);
