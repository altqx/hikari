diff --git i/libass/ass_library.c w/libass/ass_library.c
index a27aada..6580440 100644
--- i/libass/ass_library.c
+++ w/libass/ass_library.c
@@ -149,6 +149,19 @@ void ass_clear_fonts(ASS_Library *priv)
  * \param msg_cb the callback function
  * \param data additional data that will be passed to the callback
  */
+void ass_hikari_set_font_diagnostics(ASS_Library *priv,
+                                     const ASS_HikariFontDiagnostics *callbacks,
+                                     void *data)
+{
+    if (callbacks && callbacks->version == ASS_HIKARI_FONT_DIAGNOSTICS_VERSION) {
+        priv->hikari_font_diagnostics = *callbacks;
+        priv->hikari_font_diagnostics_data = data;
+    } else {
+        memset(&priv->hikari_font_diagnostics, 0, sizeof(priv->hikari_font_diagnostics));
+        priv->hikari_font_diagnostics_data = NULL;
+    }
+}
+
 void ass_set_message_cb(ASS_Library *priv,
                         void (*msg_cb)(int, const char *, va_list, void *),
                         void *data)
